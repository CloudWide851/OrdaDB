{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrdaDB",
  "version": "0.1.0",
  "identifier": "com.ordadb.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../console dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../console build && pnpm --dir ../.. package:stage:x64",
    "frontendDist": "../../console/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrdaDB",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "staging/windows-x64/ordadb-server.exe": "ordadb-server.exe",
      "staging/windows-x64/ordadb-cli.exe": "ordadb-cli.exe"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
