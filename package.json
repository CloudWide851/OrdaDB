{
  "name": "ordadb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @ordadb/console dev",
    "source:size:test": "node scripts/source-size-policy.test.mjs",
    "source:split:test": "node --test scripts/split-rust-source.test.mjs",
    "source:size": "pnpm source:size:test && node scripts/check-source-size.mjs",
    "lint": "pnpm --filter @ordadb/console lint",
    "typecheck": "pnpm --filter @ordadb/console typecheck",
    "test": "pnpm --filter @ordadb/console test",
    "test:e2e": "pnpm --filter @ordadb/console test:e2e",
    "build": "pnpm --filter @ordadb/console build",
    "installer:hooks:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer-hooks.ps1",
    "installer:hooks:compile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer-hooks.ps1 -Compile",
    "package:stage:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-windows-x64.ps1",
    "acceptance:validate:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-product-acceptance.ps1 -Mode Validate -SelfTest",
    "acceptance:preflight:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-product-acceptance.ps1 -Mode Preflight",
    "scale:smoke:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-final-scale.ps1 -Profile Smoke",
    "scale:full:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-final-scale.ps1 -Profile Full -ConfirmFullScale -RetainData",
    "desktop:dev": "pnpm --filter @ordadb/desktop dev",
    "desktop:build:x64": "pnpm --filter @ordadb/desktop build:x64"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
